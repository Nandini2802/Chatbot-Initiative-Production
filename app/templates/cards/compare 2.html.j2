<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600&family=Poppins:wght@400;500&display=swap" rel="stylesheet" />
<style>
  	/* TEMP ENDS HERE (DO not use above) */
 	*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
	body {
		font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
		background: #000;
		-webkit-font-smoothing: antialiased;
		color: #fff;
	}
	.pay-header {
		display: flex;
		align-items: center;
		gap: 16px;
		height: 56px;
		padding: 18px 16px;
		background: rgba(0,0,0,.6);
		backdrop-filter: blur(15px);
		-webkit-backdrop-filter: blur(15px);
		position: sticky;
		top: 0;
		z-index: 2;
	}
	.pay-header__title {
		flex: 1 0 0;
		min-width: 0;
		text-align: center;
		font-family: 'Montserrat', sans-serif;
		font-weight: 600;
		font-size: 17px;
		line-height: 1.2;
		letter-spacing: 1.7px;
		text-transform: uppercase;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	/* TEMP ENDS HERE (DO not use above) */

	/* Body Styles Starts Here */
	.compare { display: flex; flex-direction: column; gap: 20px; }

	/* Bot intro message */
	.compare__msg { font-family: 'Poppins', sans-serif; font-size: 12px; line-height: 1.8; }
	.compare__msg p + p { margin-top: 1.8em; }

	/* Two unit image cards */
	.compare-cards { display: flex; gap: 16px; }
	.unit-card { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
	.unit-card__media { display: flex; flex-direction: column; gap: 6px; align-items: center; }
	.unit-card__img { width: 100%; aspect-ratio: 375 / 439; background: #16171a; border-radius: 10px; display: block; }
	.unit-card__dots { display: flex; gap: 10px; align-items: center; }
	.unit-card__dots i { display: block; height: 6px; width: 6px; border-radius: 50px; background: #fff; opacity: .5; }
	.unit-card__dots i.is-active { width: 30px; opacity: 1; }
	.unit-card__price { display: flex; gap: 4px; align-items: center; justify-content: center; }
	.unit-card__price img { width: 15px; height: 13px; display: block; }
	.unit-card__price span { font-family: 'Montserrat', sans-serif; font-weight: 600; font-size: 12px; line-height: 1.2; letter-spacing: 1.2px; text-transform: uppercase; white-space: nowrap; }

	/* Accordion comparison sections (native <details>, no JS) */
	.acc { display: block; border-top: 3px solid #16171a; padding-top: 33px; }
	.acc__head {
		display: flex; align-items: center; gap: 12px; width: 100%;
		cursor: pointer; list-style: none; margin-bottom: 26px;
	}
	.acc__head::-webkit-details-marker { display: none; }
	.acc__head h3 {
		flex: 1 0 0; min-width: 0;
		font-family: 'Montserrat', sans-serif; font-weight: 600; font-size: 17px; line-height: 1.2;
		letter-spacing: 1.7px; text-transform: uppercase;
		overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
	}
	.acc__chev { flex-shrink: 0; width: 16px; height: 16px; transition: transform .2s; }
	.acc:not([open]) .acc__chev { transform: rotate(180deg); }
	.acc:not([open]) .acc__head { margin-bottom: 0; }

	.acc__body { display: flex; gap: 16px; }
	.acc__col {
		flex: 1 1 0; min-width: 0;
		display: flex; flex-direction: column; gap: 26px;
		font-family: 'Montserrat', sans-serif; font-weight: 400; font-size: 12px; line-height: 1.2;
		text-transform: capitalize;
	}
	.kv { display: flex; flex-direction: column; gap: 10px; }
	.kv .k { opacity: .6; }

	.chips { display: flex; gap: 26px;flex-wrap: wrap; }
	.chip { display: flex; gap: 6px; align-items: center; width: 49%;}
	.chip img { flex-shrink: 0; width: 24px; height: 24px; filter: brightness(0) invert(1); }
	.chip span { flex: 1 0 0; min-width: 0; }

	/* Payment plan items */
	.pp { display: flex; flex-direction: column; gap: 20px; }
	.pp__item { display: flex; flex-direction: column; gap: 10px; }
	.pp__title { opacity: .6; line-height: 1.5; }
	.pp__installments { font-weight: 600; text-transform: uppercase; }
	.pp__link { font-family: 'Poppins', sans-serif; font-weight: 500; color: #b87c01; text-decoration: underline; cursor: pointer; }
	.muted { opacity: .6; }
</style>
</head>
<body>
	<div class="pay-header">
    	<p class="pay-header__title">Compare Units (HTML)</p>
  	</div>
    <!-- Dynamic comparison: exactly two authorized units -->
    <div class="compare">
      <div class="compare-cards">
        {% for item in comparisons %}
        <div class="unit-card">
          <div class="unit-card__media">
            <div class="unit-card__img" role="img" aria-label="{{ item.unit.unit_name | default('Unit', true) | e }}"></div>
          </div>
          <div class="unit-card__price"><span>{{ item.unit.currency | default('AED', true) | e }} {{ item.unit.price if item.unit.price is not none else 'Not available' }}</span></div>
        </div>
        {% endfor %}
      </div>

      <details class="acc" open><summary class="acc__head"><h3>Overview</h3></summary><div class="acc__body">{% for item in comparisons %}<div class="acc__col"><div class="kv"><span class="k">Project</span><span>{{ item.unit.project_name if item.unit.project_name is not none and item.unit.project_name != '' else 'Not available' }}</span></div><div class="kv"><span class="k">Unit</span><span>{{ item.unit.unit_name if item.unit.unit_name is not none and item.unit.unit_name != '' else 'Not available' }}</span></div><div class="kv"><span class="k">Location</span><span>{{ item.unit.project_location if item.unit.project_location is not none and item.unit.project_location != '' else 'Not available' }}</span></div></div>{% endfor %}</div></details>
      <details class="acc" open><summary class="acc__head"><h3>Spaces</h3></summary><div class="acc__body">{% for item in comparisons %}<div class="acc__col"><div class="kv"><span class="k">Category</span><span>{{ item.unit.category if item.unit.category is not none and item.unit.category != '' else 'Not available' }}</span></div><div class="kv"><span class="k">Unit type</span><span>{{ item.unit.unit_type if item.unit.unit_type is not none and item.unit.unit_type != '' else 'Not available' }}</span></div><div class="kv"><span class="k">Bedrooms</span><span>{{ item.unit.bedrooms if item.unit.bedrooms is not none and item.unit.bedrooms != '' else 'Not available' }}</span></div><div class="kv"><span class="k">Bathrooms</span><span>{{ item.unit.bathrooms if item.unit.bathrooms is not none and item.unit.bathrooms != '' else 'Not available' }}</span></div><div class="kv"><span class="k">Parking spots</span><span>{{ item.unit.parking_spaces if item.unit.parking_spaces is not none and item.unit.parking_spaces != '' else 'Not available' }}</span></div></div>{% endfor %}</div></details>
      <details class="acc" open><summary class="acc__head"><h3>Unit Size</h3></summary><div class="acc__body">{% for item in comparisons %}<div class="acc__col"><div class="kv"><span class="k">Total area (sqft)</span><span>{{ item.unit.area_sqft if item.unit.area_sqft is not none and item.unit.area_sqft != '' else 'Not available' }}</span></div><div class="kv"><span class="k">Internal area (sqft)</span><span>{{ item.unit.internal_saleable_area if item.unit.internal_saleable_area is not none and item.unit.internal_saleable_area != '' else 'Not available' }}</span></div></div>{% endfor %}</div></details>
      <details class="acc" open><summary class="acc__head"><h3>Status</h3></summary><div class="acc__body">{% for item in comparisons %}<div class="acc__col"><div class="kv"><span class="k">Availability</span><span>{{ item.unit.status if item.unit.status is not none and item.unit.status != '' else 'Not available' }}</span></div><div class="kv"><span class="k">Handover</span><span>{{ item.unit.handover_status if item.unit.handover_status is not none and item.unit.handover_status != '' else 'Not available' }}</span></div><div class="kv"><span class="k">Construction</span><span>{{ item.unit.construction_status if item.unit.construction_status is not none and item.unit.construction_status != '' else 'Not available' }}</span></div><div class="kv"><span class="k">Project handover date</span><span>{{ item.project.handover_date if item.project.handover_date is not none and item.project.handover_date != '' else 'Not available' }}</span></div></div>{% endfor %}</div></details>
      <details class="acc" open>
        <summary class="acc__head"><h3>Project Amenities</h3></summary>
        <div class="acc__body">
          {% for item in comparisons %}
          <div class="acc__col">
            {% if item.project.amenities %}
              {% for amenity in item.project.amenities %}<p>{{ amenity | e }}</p>{% endfor %}
            {% else %}<p class="muted">Not available</p>{% endif %}
          </div>
          {% endfor %}
        </div>
      </details>
      <details class="acc" open>
        <summary class="acc__head"><h3>Project Payment Plans</h3></summary>
        <div class="acc__body">
          {% for item in comparisons %}
          <div class="acc__col">
            {% if item.project.payment_plans %}
              {% for plan in item.project.payment_plans %}<p>{{ plan | e }}</p>{% endfor %}
            {% else %}<p class="muted">Not available</p>{% endif %}
          </div>
          {% endfor %}
        </div>
      </details>
    </div>
	<!-- Compared Units /. -->
</body>
</html>
