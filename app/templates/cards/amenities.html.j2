
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    background: transparent;
    color: #fff;
    -webkit-font-smoothing: antialiased;
  }
  /* 2-column grid of amenity cards (icon + name). */
  .am-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .am-card {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #16171a;
    border-radius: 16px;
    padding: 14px;
    min-width: 0;
  }
  .am-icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    overflow: hidden;
    background: #221d12;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  /* Icon assets (transparent PNGs) — show the whole icon with a little padding, not cropped. */
  .am-icon img { width: 100%; height: 100%; object-fit: contain; padding: 6px; display: block; }
  .am-label {
    font-size: 13px;
    font-weight: 500;
    line-height: 1.35;
    color: #fff;
    overflow-wrap: anywhere;
  }
</style>
</head>
<body>
<div class="am-grid">

  {% for amenity in amenities %}
  <div class="am-card">
    <span class="am-icon"><img src="{{ amenity.category_image | e }}" alt="" loading="lazy"></span>
    <span class="am-label">{{ amenity.label | e }}</span>
  </div>
  {% endfor %}

</div>
</body>
</html>
