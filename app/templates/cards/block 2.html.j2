<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    background: transparent;
    -webkit-font-smoothing: antialiased;
  }
  .file-stack { display: flex; flex-direction: column; gap: 10px; }
  .file-card {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    background: #16171a;
    border-radius: 16px;
    padding: 14px 16px;
  }
  .file-icon {
    flex-shrink: 0;
    color: #fff;
    display: flex;
  }
  .file-info { flex: 1; min-width: 0; }
  .file-name {
    font-size: 15px;
    font-weight: 600;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .file-meta {
    font-size: 12.5px;
    color: #8b8d92;
    margin-top: 3px;
  }
  .download-btn {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: linear-gradient(135deg, #e0aa4a 0%, #c9963a 100%);
    color: #16171a;
    text-decoration: none;
    transition: transform .12s, filter .18s;
    border: 0;
    cursor: pointer;
  }
  .download-btn:hover { filter: brightness(1.06); transform: translateY(-1px); }
  .download-btn:active { transform: translateY(0); }
  .download-btn svg { width: 20px; height: 20px; }
</style>
