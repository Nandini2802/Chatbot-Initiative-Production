
<div style="
    background:#101010;
    color:#ffffff;
    padding:18px;
    border-radius:18px;
    font-family:Arial,sans-serif;
    max-width:430px;
">

    <div style="
        font-size:15px;
        font-weight:600;
        margin-bottom:6px;
    ">
        Bank Accounts
    </div>

    <div style="
        font-size:12px;
        color:#aaaaaa;
        margin-bottom:16px;
    ">
        {{ project }}
        · {{ accounts|length }} account(s)
    </div>

    {% for account in accounts %}

    <details style="
        background:#1b1b1b;
        border-radius:15px;
        padding:15px;
        margin-bottom:12px;
    ">

        <summary style="
            cursor:pointer;
            list-style-position:inside;
        ">

            <div style="
                display:inline-block;
                vertical-align:middle;
                max-width:85%;
            ">

                <div style="
                    font-size:14px;
                    font-weight:600;
                    margin-bottom:7px;
                ">
                    {{ account.bankType }}
                </div>

                <div style="
                    display:flex;
                    align-items:center;
                    gap:10px;
                ">

                    {% if account.bankLogo %}
                    <img
                        src="{{ account.bankLogo }}"
                        alt="Bank logo"
                        style="
                            width:34px;
                            height:34px;
                            object-fit:contain;
                            background:white;
                            border-radius:5px;
                        "
                    >
                    {% endif %}

                    <div>
                        <div style="
                            color:#aaaaaa;
                            font-size:12px;
                        ">
                            {{ account.bankName }}
                        </div>

                        <div style="
                            color:#888888;
                            font-size:11px;
                        ">
                            {{ account.accountNumber or "" }}
                        </div>
                    </div>

                </div>
            </div>

        </summary>

        <div style="
            border-top:1px solid #333333;
            margin-top:14px;
            padding-top:14px;
            font-size:12px;
            line-height:1.9;
            overflow-wrap:anywhere;
        ">

            <div>
                <strong>Beneficiary:</strong>
                {{ account.beneficiaryName or "Not available" }}
            </div>

            <div>
                <strong>Bank:</strong>
                {{ account.bankName }}
            </div>

            <div>
                <strong>Account Number:</strong>
                {{ account.accountNumber or "Not available" }}
            </div>

            <div>
                <strong>IBAN:</strong>
                {{ account.ibanNumber or "Not available" }}
            </div>

            <div>
                <strong>SWIFT/BIC:</strong>
                {{ account.swiftCode or "Not available" }}
            </div>

            <div>
                <strong>Branch:</strong>
                {{ account.branch or "Not available" }}
            </div>

        </div>

    </details>

    {% endfor %}

</div>
