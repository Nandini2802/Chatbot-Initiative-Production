
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<style>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont,
      'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    background: transparent;
    -webkit-font-smoothing: antialiased;
  }

  .bank-stack {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .bank-card {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    background: #16171a;
    border-radius: 16px;
    padding: 16px;
    cursor: pointer;
    border: 0;
    text-align: left;
    font: inherit;
  }

  .bank-card:hover {
    background: #202126;
  }

  .bank-card:focus-visible {
    outline: 2px solid #8b8d92;
    outline-offset: 2px;
  }

  .bank-card__logo {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .bank-card__logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .bank-card__info {
    flex: 1;
    min-width: 0;
  }

  .bank-card__title {
    font-size: 15px;
    font-weight: 600;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .bank-card__name {
    font-size: 13px;
    color: #8b8d92;
    margin-top: 5px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .bank-card__acct {
    font-size: 13px;
    color: #8b8d92;
    margin-top: 3px;
  }

  .bank-card__chev {
    flex-shrink: 0;
    color: #8b8d92;
    display: flex;
  }
</style>
</head>

<body>

<div class="bank-stack"
     data-project-id="{{ project_id | e }}">

  {% for account in accounts %}

  <button
    type="button"
    class="bank-card"
    data-account-type="{{ account.bankType | e }}"
    data-account-index="{{ account.accountIndex if account.accountIndex is not none else '' }}"
    onclick="bankSendCard(this)">

    <span class="bank-card__logo">
      <img
        src="{{ account.bankLogo | default('', true) | e }}"
        alt=""
      />
    </span>

    <div class="bank-card__info">

      <div class="bank-card__title">
        {{ account.displayBankType | e }}
      </div>

      <div class="bank-card__name">
        {{ account.bankName | e }}
      </div>

      <div class="bank-card__acct">
        {{ account.accountNumber | default('Not available', true) | e }}
      </div>

    </div>

    <span class="bank-card__chev">
      <svg
        viewBox="0 0 24 24"
        width="22"
        height="22"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round">

        <polyline points="9 6 15 12 9 18"/>
      </svg>
    </span>

  </button>

  {% endfor %}

</div>

<script>
function bankSendCard(card) {

    // Prevent rapid double-clicks.
    if (card.dataset.sent === "1") {
        return;
    }

    const stack = card.closest(".bank-stack");

    const projectId = stack
        ? stack.dataset.projectId
        : null;

    const rawAccountType = (
        card.dataset.accountType || ""
    ).trim();

    const accountType = rawAccountType
        .split("(")[0]
        .trim()
        .toUpperCase();

    const accountIndex = Number(
        card.dataset.accountIndex
    );

    const labelElement = card.querySelector(
        ".bank-card__title"
    );

    const label = labelElement
        ? labelElement.textContent.trim()
        : "";

    // Validate selection before sending.
    if (
        !projectId ||
        !["ESCROW", "CORPORATE"].includes(accountType) ||
        !Number.isInteger(accountIndex) ||
        accountIndex < 1
    ) {
        console.error(
            "Invalid bank account selection",
            {
                projectId,
                accountType,
                accountIndex
            }
        );
        return;
    }

    const action = {
        type: "bank_account_selection",
        project_id: projectId,
        account_type: accountType,
        account_index: accountIndex
    };

    card.dataset.sent = "1";

    try {

        window.parent.postMessage(
            {
                source: "danube-bank",
                type: "send_message",
                message: label,
                extra: {
                    action: action
                }
            },
            "*"
        );

    } catch (error) {

        console.error(
            "Bank account click failed",
            error
        );

    }

    setTimeout(function () {
        delete card.dataset.sent;
    }, 1500);
}
</script>

</body>
</html>
