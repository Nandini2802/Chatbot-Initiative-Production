<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet" />
<style>
	/* TEMP ENDS HERE (DO not use above) */
 	*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
	body {
		font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
		background: #000;
		-webkit-font-smoothing: antialiased;
		color: #fff;
	}
	.pay-header {
		display: flex;
		align-items: center;
		gap: 16px;
		height: 56px;
		padding: 18px 16px;
		background: rgba(0,0,0,.6);
		backdrop-filter: blur(15px);
		-webkit-backdrop-filter: blur(15px);
		position: sticky;
		top: 0;
		z-index: 2;
	}
	.pay-header__title {
		flex: 1 0 0;
		min-width: 0;
		text-align: center;
		font-family: 'Montserrat', sans-serif;
		font-weight: 600;
		font-size: 17px;
		line-height: 1.2;
		letter-spacing: 1.7px;
		text-transform: uppercase;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	/* TEMP ENDS HERE (DO not use above) */

	/* Body Styles Starts Here */
	.pay-body { padding: 10px 16px 24px; display: flex; flex-direction: column; gap: 20px; }
	.pay-field {
		display: flex;
		gap: 10px;
		align-items: center;
		height: 56px;
		padding: 8px 16px;
		border-radius: 10px;
		background: #111;
	}
	.pay-field__text { flex: 1 0 0; min-width: 0; }
	.pay-field__label { font-size: 12px; line-height: 1.5; opacity: .6; }
	.pay-field__value { font-size: 13px; font-weight: 500; line-height: 1.2; }
	.pay-field img { width: 16px; height: 16px; display: block; flex-shrink: 0; }

	/* Year table cards */
	.pay-year {
		background: #111;
		border-radius: 14px;
		padding: 20px;
		display: flex;
		flex-direction: column;
		gap: 20px;
	}
	.pay-year__title {
		font-family: 'Montserrat', sans-serif;
		font-weight: 600;
		font-size: 17px;
		line-height: 1.2;
		letter-spacing: 1.7px;
		text-transform: uppercase;
	}
	.pay-year__rule { height: 1px; background: #000; }
	.pay-table { display: flex; flex-direction: column; gap: 20px; }
	.pay-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; line-height: 1.2; }
	.pay-row .c-milestone { flex: 1 0 0; min-width: 0; display: flex; flex-direction: column; gap: 4px; }
	.pay-row .c-percent { width: 50px; flex-shrink: 0; }
	.pay-row .c-amount { display: flex; align-items: center; justify-content: flex-end; gap: 6px; flex-shrink: 0; }
	.pay-row .c-amount img { width: 15px; height: 13px; display: block; }
	/* Head row */
	.pay-row--head .c-milestone,
	.pay-row--head .c-percent { font-size: 13px; opacity: .6; }
	.pay-row--head .c-amount { font-size: 13px; font-weight: 600; }
	/* Data rows: muted date/subtitle/percent, bold amount */
	.pay-row .m-date { font-size: 13px; opacity: .6; }
	.pay-row .m-note { font-size: 10px; opacity: .6; }
	.pay-row .c-percent { font-size: 13px; opacity: .6; }
	.pay-row .c-amount .amt { font-size: 13px; font-weight: 600; white-space: nowrap; }
</style>
</head>
