<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500&display=swap" rel="stylesheet" />
<style>
	/* TEMP ENDS HERE (DO not use above) */
 	*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
	body {
		font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
		-webkit-font-smoothing: antialiased;
		color: #fff;
		padding-bottom: 96px;
	}
	.pay-header {
		display: flex;
		align-items: center;
		gap: 16px;
		height: 56px;
		padding: 18px 16px;
		background: rgba(0,0,0,.6);
		backdrop-filter: blur(15px);
		-webkit-backdrop-filter: blur(15px);
		position: sticky;
		top: 0;
		z-index: 2;
	}
	.pay-header__title {
		flex: 1 0 0;
		min-width: 0;
		text-align: center;
		font-family: 'Montserrat', sans-serif;
		font-weight: 600;
		font-size: 17px;
		line-height: 1.2;
		letter-spacing: 1.7px;
		text-transform: uppercase;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	/* TEMP ENDS HERE (DO not use above) */

	/* UNIT LISTING */
	.unit-table {
		display: flex;
		flex-direction: column;
		background: #111;
		border-radius: 10px;
		overflow: hidden;
	}
	.unit-table__head {
		display: flex;
		gap: 5px;
		padding: 10px;
		color: #000;
		line-height: 1.5;
		background: linear-gradient(100.45deg, #b87c01 0%, #d7ac50 21.26%, #dc9b15 100%);
	}
	.unit-table__head .col-title { font-weight: 500; font-size: 12px; }
	.unit-table__head .col-sub { font-weight: 400; font-size: 10px; }
	/* Column widths match the Figma spec; Property flexes to fill. */
	.col-property { flex: 1 0 0; min-width: 1px; }
	.col-area  { width: 50px; }
	.col-type  { width: 70px; }
	.col-price { width: 50px; }

	.unit-table__body { display: flex; flex-direction: column; padding: 0 10px; }
	.unit-row {
		display: flex;
		gap: 5px;
		padding: 16px 0;
		border-bottom: 1px solid #000;
		color: #fff;
		font-weight: 400;
		font-size: 12px;
		line-height: 1.5;
	}
	.unit-row .col-property { white-space: nowrap; }
	/* UNIT LISTING */

	/* PAGINATION — only shown when records exceed one page (20) */
	.unit-pagination {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 6px;
		padding: 14px 10px;
	}
	.unit-pagination__btn {
		min-width: 32px;
		height: 32px;
		padding: 0 10px;
		border: 1px solid #333;
		border-radius: 8px;
		background: #111;
		color: #fff;
		font-family: inherit;
		font-size: 12px;
		cursor: pointer;
	}
	.unit-pagination__btn:disabled { opacity: .4; cursor: default; }
	.unit-pagination__btn--active {
		border-color: transparent;
		color: #000;
		font-weight: 500;
		background: linear-gradient(100.45deg, #b87c01 0%, #d7ac50 21.26%, #dc9b15 100%);
	}
	.unit-pagination__ellipsis { color: #777; padding: 0 2px; }
</style>
</head>
<body>
	<div class="pay-header">
		<p class="pay-header__title">UNIT LISTING</p>
	</div>

	<!-- UNITS LISTING -->
	<div class="unit-table">
		<div class="unit-table__head">
			<p class="col-property col-title">Property</p>
			<div class="col-area">
				<p class="col-title">Area</p>
				<p class="col-sub">(sqft)</p>
			</div>
			<p class="col-type col-title">Unit Type</p>
			<div class="col-price">
				<p class="col-title">Price</p>
				<p class="col-sub">(AED)</p>
			</div>
		</div>
		<div class="unit-table__body" id="unitRows"><!-- rows rendered by JS --></div>
	</div>
	<div class="unit-pagination" id="unitPagination"></div>
	<!-- UNITS LISTING /. -->

	<script>
	(function () {
		var PAGE_SIZE = 10;   // show up to 20 per page; paginate beyond that

		// Dynamic inventory data supplied by the existing Jinja template.
		var units = [
		{% for unit in units %}
			{
				property: {{ (unit.unit_name or "N/A") | string | e | tojson }},
				area: {% if unit.area_sqft is not none and unit.area_sqft != "" %}{{ unit.area_sqft | string | e | tojson }}{% else %}"N/A"{% endif %},
				type: {% if unit.bedrooms is not none and unit.bedrooms != "" %}{% if unit.bedrooms | string == "0" %}"Studio"{% else %}{{ (unit.bedrooms | string ~ " BR") | e | tojson }}{% endif %}{% elif unit.unit_type %}{{ unit.unit_type | string | e | tojson }}{% else %}"N/A"{% endif %},
				price: {% if unit.price is not none and unit.price != "" %}{{ (((unit.currency ~ " ") if unit.currency and unit.currency != "AED" else "") ~ "{:,.0f}".format(unit.price | float)) | e | tojson }}{% else %}"N/A"{% endif %}
			}{% if not loop.last %},{% endif %}
		{% endfor %}
		];

		var rowsEl = document.getElementById('unitRows');
		var pagerEl = document.getElementById('unitPagination');
		var pageCount = Math.ceil(units.length / PAGE_SIZE);
		var current = 1;

		function renderRows() {
			var start = (current - 1) * PAGE_SIZE;
			var slice = units.slice(start, start + PAGE_SIZE);
			rowsEl.innerHTML = slice.map(function (u) {
				return '<div class="unit-row">' +
					'<div class="col-property">' + u.property + '</div>' +
					'<div class="col-area">' + u.area + '</div>' +
					'<div class="col-type">' + u.type + '</div>' +
					'<div class="col-price">' + u.price + '</div>' +
					'</div>';
			}).join('');
		}

		// Windowed page numbers: first, last, current ±1, ellipsis for gaps.
		function pageNumbers() {
			var pages = [], i;
			for (i = 1; i <= pageCount; i++) {
				if (i === 1 || i === pageCount || (i >= current - 1 && i <= current + 1)) pages.push(i);
				else if (pages[pages.length - 1] !== '…') pages.push('…');
			}
			return pages;
		}

		function renderPager() {
			// Pagination only appears when there's more than one page (i.e. > 20 records).
			if (pageCount <= 1) { pagerEl.innerHTML = ''; return; }
			var html = '<button class="unit-pagination__btn" data-go="prev"' + (current === 1 ? ' disabled' : '') + '>‹</button>';
			pageNumbers().forEach(function (p) {
				if (p === '…') { html += '<span class="unit-pagination__ellipsis">…</span>'; return; }
				html += '<button class="unit-pagination__btn' + (p === current ? ' unit-pagination__btn--active' : '') + '" data-go="' + p + '">' + p + '</button>';
			});
			html += '<button class="unit-pagination__btn" data-go="next"' + (current === pageCount ? ' disabled' : '') + '>›</button>';
			pagerEl.innerHTML = html;
		}

		function goTo(page) {
			current = Math.min(Math.max(1, page), pageCount);
			renderRows();
			renderPager();
		}

		pagerEl.addEventListener('click', function (e) {
			var btn = e.target.closest('[data-go]');
			if (!btn) return;
			var go = btn.getAttribute('data-go');
			if (go === 'prev') goTo(current - 1);
			else if (go === 'next') goTo(current + 1);
			else goTo(parseInt(go, 10));
		});

		renderRows();
		renderPager();
	})();
	</script>
</body>
</html>
